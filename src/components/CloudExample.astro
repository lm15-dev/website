---
// One example of a cloud page, in the reader's language: the file from
// src/data/<page>/ as the page's capture script ran it, and what it printed.
// Pages and scripts:
//   google-cloud  "Use Google Cloud"        scripts/capture-google-cloud.py
//   aws           "Use AWS"                  scripts/capture-cloud.py aws (+ capture-aws-ec2.sh)
//   azure         "Use Microsoft Azure"      scripts/capture-cloud.py azure
//   clouds        "Use a cloud provider"     scripts/capture-cloud.py clouds
// The header's language choice shows one panel (the same switch as the setup
// instructions, `data-doc-install-language`); Python is shown until a script
// runs. R and Julia have no cloud examples yet; a language with no file for
// one example says so.
import { Code } from '@astrojs/starlight/components';
import google from '../data/google-cloud-captures.json';
import aws from '../data/aws-captures.json';
import azure from '../data/azure-captures.json';
import clouds from '../data/clouds-captures.json';

type Run = { code: string; output: string; error?: string; model?: string };
type Captures = { date: string; dates?: Record<string, string>; steps: Record<string, Record<string, unknown>> };
const CAPTURES: Record<string, Captures> = { 'google-cloud': google, aws, azure, clouds } as Record<string, Captures>;
const FILES = import.meta.glob('../data/{google-cloud,aws,azure,clouds}/*', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const WRITTEN = [
  { id: 'python', ext: 'py', lang: 'python', label: 'Python' },
  { id: 'typescript', ext: 'ts', lang: 'ts', label: 'TypeScript' },
  { id: 'rust', ext: 'rs', lang: 'rust', label: 'Rust' },
  { id: 'go', ext: 'go', lang: 'go', label: 'Go' },
] as const;
const NOT_YET = [{ id: 'r', label: 'R' }, { id: 'julia', label: 'Julia' }] as const;
const WHERE: Record<string, string> = {
  vertex: 'Vertex AI', 'vertex-express': 'Vertex AI express mode',
  'bedrock-chat': 'Amazon Bedrock', 'bedrock-mantle-chat': 'Amazon Bedrock (mantle)',
  azure: 'Azure OpenAI',
};
const MODEL: Record<string, string> = {
  'gemini-2.5-flash': 'Gemini 2.5 Flash', 'deepseek.v3.2': 'DeepSeek V3.2',
  'openai.gpt-oss-120b-1:0': 'gpt-oss-120b', 'openai.gpt-oss-120b': 'gpt-oss-120b',
  'gpt-4.1-mini': 'GPT-4.1 mini',
};

interface Props {
  /** The page's data folder: google-cloud, aws, azure or clouds. */
  page?: string;
  /** The file name in src/data/<page>/, without its extension. */
  name: string;
  /** Show what it printed (a recorded step of the same name, unless `step` says otherwise). */
  output?: boolean;
  step?: string;
  /** false: show only what it printed (the code is on the page already). */
  code?: boolean;
  /** Where it ran, when not on a laptop: "on an EC2 instance". */
  on?: string;
  /** Said to a reader whose language has no file for this example. */
  missing?: string;
}
const { page = 'google-cloud', name, output = false, step = name, code: showCode = true, on, missing } = Astro.props;
const captures = CAPTURES[page];
if (!captures) throw new Error(`CloudExample: no page ${page}`);
const runs = captures.steps[step] as Record<string, Run> | undefined;
if ((output || !showCode) && !runs) throw new Error(`CloudExample: ${page} has no recorded step ${step}`);
const day = captures.dates?.[step] ?? captures.date;
const date = new Date(`${day}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
function who(run: Run): string {
  const parts: string[] = [];
  if (on) parts.push(on);
  if (run.model) {
    const cut = run.model.indexOf(':');
    const [provider, model] = [run.model.slice(0, cut), run.model.slice(cut + 1)];
    parts.push(`${MODEL[model] ?? model} on ${WHERE[provider] ?? provider}`);
  }
  parts.push(date);
  return parts.join(', ');
}
const panels = WRITTEN.map(({ id, ext, lang, label }) => {
  const code = FILES[`../data/${page}/${name}.${ext}`];
  const run = output || !showCode ? runs![id] : undefined;
  if (code === undefined) {
    if (run) throw new Error(`CloudExample: ${page}/${step}/${id} was recorded, but ${name}.${ext} is gone`);
    return { id, lang, label, code: undefined, run };
  }
  if ((output || !showCode) && !run) throw new Error(`CloudExample: ${page}/${step} has no ${id} recording`);
  if (run && run.code !== code) throw new Error(`CloudExample: ${page}/${step}/${id} was recorded from another version of ${name}.${ext}; re-run its capture script`);
  return { id, lang, label, code: code.trimEnd(), run };
});
const available = panels.filter(panel => panel.code !== undefined).map(panel => panel.label);
const choose = `choose ${available.slice(0, -1).join(', ')}${available.length > 2 ? ',' : ''} or ${available.at(-1)} above`;
---
<div class="cloud-example">
  {panels.map(panel => panel.code === undefined ? (
    <p class="cloud-not-yet" data-doc-install-language={panel.id} hidden={panel.id !== 'python'}>
      {missing ?? `This example has no ${panel.label} version yet: ${choose}.`}
    </p>
  ) : (
    <div data-doc-install-language={panel.id} hidden={panel.id !== 'python'}>
      {showCode && <Code code={panel.code} lang={panel.lang} />}
      {panel.run && (
        <figure class="captured not-content">
          <figcaption>What it printed <span>{who(panel.run)}</span></figcaption>
          <pre class="captured-text">{(panel.run.output || panel.run.error || '').replace(/^\n+|\n+$/g, '')}</pre>
        </figure>
      )}
    </div>
  ))}
  {NOT_YET.map(({ id, label }) => (
    <p class="cloud-not-yet" data-doc-install-language={id} hidden>
      This page has no {label} example yet: choose Python, TypeScript, Rust or Go above.
    </p>
  ))}
</div>

<style>
  .cloud-example { margin-block: 1.25rem 1.5rem; }
  .cloud-not-yet { padding: .7rem .9rem; border: 1px dashed var(--sl-color-gray-4); color: var(--sl-color-gray-2); font-size: .9rem; }
  .captured { margin: 1rem 0 1.5rem; border: 1px solid var(--sl-color-gray-5); border-left: 3px solid var(--lm-accent); background: var(--sl-color-bg); }
  figcaption { padding: .45rem .9rem; font-size: .8rem; font-weight: 600; color: var(--sl-color-gray-2); border-bottom: 1px solid var(--sl-color-gray-5); }
  figcaption span { font-weight: 400; margin-left: .4rem; }
  .captured-text { margin: 0; padding: .8rem .9rem; font-family: var(--lm-code-font); font-size: var(--sl-text-code, .875rem); line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--sl-color-text); background: none; border: 0; }
</style>

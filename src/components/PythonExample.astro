---
// One Python example, shown exactly as the file scripts/capture-*.py ran
// (for pages that are Python only for now, such as "Set up authentication").
import { Code } from '@astrojs/starlight/components';

const FILES = import.meta.glob('../data/{authentication,judgments}/*.py', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
interface Props { name: string; set?: 'authentication' | 'judgments' }
const { name, set = 'authentication' } = Astro.props;
const code = FILES[`../data/${set}/${name}.py`];
if (code === undefined) throw new Error(`PythonExample: no example ${set}/${name}`);
---
<Code code={code.trimEnd()} lang="python" />

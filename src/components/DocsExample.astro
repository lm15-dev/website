---
import { DEFAULT_SELECTION, RECIPES, type Recipe } from '../data/docs-examples';
import { CONTINUATION, layout } from '../playground/code-view';
interface Props { recipe?: Recipe }
const { recipe = 'tour-first' } = Astro.props;
const selection = DEFAULT_SELECTION;
// The same markup the playground's renderCode builds, so the page is coloured before any script runs.
const lines = layout(RECIPES[recipe](selection));
const classes = (kinds: readonly string[]) => kinds.map(kind => `tok-${kind}`).join(' ');
---
<section class="docs-example" data-docs-example data-recipe={recipe} aria-label="Configurable example">

  <div class="docs-source not-content">
    <button type="button" data-doc-copy aria-label="Copy example code">Copy</button>
    <pre class="lm-code" tabindex="0" aria-label="Example source code"><code data-doc-source>{lines.map(line => <span class="line" style={`--indent: ${line.indent + CONTINUATION}`}>{line.segments.map(segment => segment.kinds.length ? <span class={classes(segment.kinds)}>{segment.text}</span> : segment.text)}</span>)}</code></pre>
  </div>
  <p class="docs-example-hint" data-doc-status role="status" aria-live="polite"></p>
  <noscript>Enable JavaScript to change these choices. The Python example is shown above.</noscript>
</section>
<script>
  import { setupDocsExamples } from './docs-examples-client';
  setupDocsExamples();
  document.addEventListener('astro:page-load', setupDocsExamples);
</script>
<style>
  .docs-example { margin-block: 1.5rem; }
  button:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .docs-source { position: relative; }
  /* Examples fit the box on a desktop (tests/docs_example_widths.test.ts); a narrower screen scrolls them sideways rather than break their lines. */
  .docs-source pre { margin: 0; padding: 2.7rem 1rem 1rem; font-size: var(--sl-text-code, .875rem); border: 1px solid var(--sl-color-gray-5); overflow-x: auto; white-space: pre; overflow-wrap: normal; }
  .docs-source button { position: absolute; right: .6rem; top: .5rem; padding: .15rem .5rem; font: inherit; font-size: .8rem; color: var(--sl-color-text); background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-4); border-radius: .25rem; cursor: pointer; }
  .docs-example-hint { font-size: .85rem; color: var(--sl-color-gray-2); }
  [data-doc-status]:empty { display: none; }
</style>

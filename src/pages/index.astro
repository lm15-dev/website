---
import '../styles/home.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Direct access to model APIs. LM15 SDKs share one request and response model across providers and languages." />
    <link rel="canonical" href="https://lm15.dev/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>LM15 — Direct access to model APIs</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a class="brand" href="/" aria-label="LM15 home">lm15<span aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        <a href="/docs/">Docs</a>
        <a href="/playground/">Playground</a>
        <a href="https://github.com/lm15-dev">GitHub ↗</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero">
        <h1>All Providers<br>One API</h1>
        <div class="actions"><a class="button" href="/docs/languages/">Start building →</a><a class="secondary" href="/playground/">Try the playground</a></div>
        <p class="languages">Python · TypeScript · Rust · Go · R · Julia</p>
      </section>
    </main>
    <footer><span>LM15 · One family of model API clients.</span><a href="/playground/about/">Privacy & licenses</a><a href="https://github.com/lm15-dev/lm15-contract">Shared contract ↗</a></footer>
  </body>
</html>

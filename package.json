{
  "name": "lm15-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-playground.mjs && astro build && node scripts/check-links.mjs",
    "check": "astro check && tsc -p tsconfig.playground.json --noEmit",
    "test": "node --experimental-strip-types --test tests/code_view.test.ts tests/provider_examples.test.ts tests/packaging.test.ts",
    "test:browser": "node --experimental-strip-types --test tests/playground.test.ts tests/published.test.ts tests/navigation.test.ts tests/theme.test.ts tests/docs-setup.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "preview": "astro preview --host 127.0.0.1",
    "verify": "npm run check && npm test && npm run build && npm run test:browser",
    "playground:local": "node --experimental-strip-types scripts/serve-playground.ts --local-keys --open",
    "rust:snippets": "node --experimental-strip-types scripts/rust-snippets.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.2",
    "lm15": "https://github.com/lm15-dev/website/releases/download/runtimes-2026-09-13-1/runtime-package.tgz"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "^22.0.0",
    "chokidar": "4.0.3",
    "parse5": "8.0.0",
    "playwright-core": "1.63.0",
    "pyodide": "0.29.3",
    "typescript": "5.9.3"
  }
}

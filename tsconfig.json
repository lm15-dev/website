{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*.ts", "scripts/**/*.ts"],
  // identity.ts imports @azure/identity, which the site doesn't install;
  // scripts/capture-cloud.py installs it and runs the file for real
  "exclude": ["dist", ".build", "src/data/azure/identity.ts"],
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  }
}
